# --- Gemini credentials (choose ONE) ---------------------------------------
# Option A: Google AI Studio key (simplest for local dev)
GOOGLE_API_KEY=your-key-here

# Option B: Vertex AI (production / GCP)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- BookForge pipeline settings (all optional, defaults shown) -------------
BOOKFORGE_ANALYST_MODEL=gemini-2.5-flash
BOOKFORGE_WRITER_MODEL=gemini-2.5-pro
BOOKFORGE_CRITIC_MODEL=gemini-2.5-flash

# --- Optional: OpenAI-compatible endpoint (e.g. NVIDIA NIM) ------------------
# When base URL + key are set and models don't start with "gemini-",
# they route through the custom endpoint instead of Gemini.
# BOOKFORGE_OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# BOOKFORGE_OPENAI_API_KEY=nvapi-your-key-here
BOOKFORGE_FRAME_INTERVAL_SEC=5
BOOKFORGE_FRAME_PHASH_THRESHOLD=6
BOOKFORGE_MAX_FRAMES_PER_CHAPTER=12
# BOOKFORGE_MAX_VIDEOS=            # empty = whole channel
BOOKFORGE_DOWNLOAD_RESOLUTION=480
BOOKFORGE_WHISPER_MODEL=base
BOOKFORGE_QA_MAX_ITERATIONS=3
BOOKFORGE_WORKSPACE_ROOT=data
BOOKFORGE_COMPILE_LATEX=true
BOOKFORGE_LOG_LEVEL=INFO
BOOKFORGE_MEDIA_PREFETCH_CONCURRENCY=3

# --- MLflow tracing (official Google ADK OTLP spec) -------------------------
# Start with ./start_all.sh or start_all.ps1 so these are exported BEFORE adk web.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=my-experiment
# BOOKFORGE_DISABLE_MLFLOW_TRACING=1
