# BookForge Go Environment Variables
# Copy this to .env and fill in your credentials

# Google Gemini API Key (required)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-api-key-here

# Optional: OpenAI/NVIDIA NIM API for alternative models
# OPENAI_API_KEY=your-openai-key
# OPENAI_API_BASE=https://integrate.api.nvidia.com/v1

# BookForge Configuration
BOOKFORGE_WORKSPACE_ROOT=data
BOOKFORGE_MAX_VIDEOS=0
BOOKFORGE_COMPILE_LATEX=true
BOOKFORGE_FRAME_INTERVAL_SEC=5
BOOKFORGE_MAX_FRAMES_PER_CHAPTER=12
